me>[fee_hourly_panel.csv]</parent-name><remote-alias>avg_base_fee_gwei</remote-alias><ordinal>5</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>avg_block_utilization</remote-name><remote-type>5</remote-type><local-name>[avg_block_utilization]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>avg_block_utilization</remote-alias><ordinal>6</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>network_tx_count</remote-name><remote-type>20</remote-type><local-name>[network_tx_count]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>network_tx_count</remote-alias><ordinal>7</ordinal><local-type>integer</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>blocks</remote-name><remote-type>20</remote-type><local-name>[blocks]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>blocks</remote-alias><ordinal>8</ordinal><local-type>integer</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>eth_usd</remote-name><remote-type>5</remote-type><local-name>[eth_usd]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>eth_usd</remote-alias><ordinal>9</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>oracle_swaps</remote-name><remote-type>20</remote-type><local-name>[oracle_swaps]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>oracle_swaps</remote-alias><ordinal>10</ordinal><local-type>integer</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>est_transfer_fee_usd</remote-name><remote-type>5</remote-type><local-name>[est_transfer_fee_usd]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>est_transfer_fee_usd</remote-alias><ordinal>11</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>p2p_small_transfers</remote-name><remote-type>5</remote-type><local-name>[p2p_small_transfers]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>p2p_small_transfers</remote-alias><ordinal>12</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>p2p_large_transfers</remote-name><remote-type>5</remote-type><local-name>[p2p_large_transfers]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>p2p_large_transfers</remote-alias><ordinal>13</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>p2p_micro_transfers</remote-name><remote-type>5</remote-type><local-name>[p2p_micro_transfers]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>p2p_micro_transfers</remote-alias><ordinal>14</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>p2p_transfers</remote-name><remote-type>5</remote-type><local-name>[p2p_transfers]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>p2p_transfers</remote-alias><ordinal>15</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>p2p_volume_usd</remote-name><remote-type>5</remote-type><local-name>[p2p_volume_usd]</local-name><parent-name>[fee_hourly_panel.csv]</parent-name><remote-alias>p2p_volume_usd</remote-alias><ordinal>16</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record></metadata-records></connection><aliases enabled="yes" /><column caption="Hour ts" datatype="datetime" name="[hour_ts]" role="dimension" type="quantitative" /><column caption="Activity date" datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column caption="Hour of day" datatype="integer" name="[hour_of_day]" role="dimension" type="ordinal" /><column caption="Day of week" datatype="integer" name="[day_of_week]" role="dimension" type="ordinal" /><column caption="Protocol era" datatype="string" name="[protocol_era]" role="dimension" type="nominal" /><column caption="Avg base fee gwei" datatype="real" name="[avg_base_fee_gwei]" role="measure" type="quantitative" /><column caption="Avg block utilization" datatype="real" name="[avg_block_utilization]" role="measure" type="quantitative" /><column caption="Network tx count" datatype="integer" name="[network_tx_count]" role="measure" type="quantitative" /><column caption="Blocks" datatype="integer" name="[blocks]" role="measure" type="quantitative" /><column caption="Eth usd" datatype="real" name="[eth_usd]" role="measure" type="quantitative" /><column caption="Oracle swaps" datatype="integer" name="[oracle_swaps]" role="measure" type="quantitative" /><column caption="Est transfer fee usd" datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column caption="P2p small transfers" datatype="real" name="[p2p_small_transfers]" role="measure" type="quantitative" /><column caption="P2p large transfers" datatype="real" name="[p2p_large_transfers]" role="measure" type="quantitative" /><column caption="P2p micro transfers" datatype="real" name="[p2p_micro_transfers]" role="measure" type="quantitative" /><column caption="P2p transfers" datatype="real" name="[p2p_transfers]" role="measure" type="quantitative" /><column caption="P2p volume usd" datatype="real" name="[p2p_volume_usd]" role="measure" type="quantitative" /><column caption="Small share of P2P" datatype="real" name="[Calculation_c_small_share]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM([p2p_small_transfers]) / SUM([p2p_transfers])" /></column><column caption="Day of week (UTC)" datatype="string" name="[Calculation_c_weekday]" role="dimension" type="nominal"><calculation class="tableau" formula="STR(DATEPART('weekday', [hour_ts])) + ' ' + DATENAME('weekday', [hour_ts])" /></column><column caption="Last 12 months" datatype="boolean" name="[Calculation_c_last12]" role="dimension" type="nominal"><calculation class="tableau" formula="[activity_date] &gt;= #2024-07-01#" /></column><column caption="Median fee per transfer" datatype="real" name="[Calculation_c_fee_med]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="MEDIAN([est_transfer_fee_usd])" /></column><column caption="Average fee per transfer" datatype="real" name="[Calculation_c_fee_avg]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="AVG([est_transfer_fee_usd])" /></column><column caption="Cheapest hour of the day: fee" datatype="real" name="[Calculation_c_cheapest_hour_fee]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="{FIXED [activity_date] : MIN([est_transfer_fee_usd])}" /></column><column caption="Monthly fee bill: send any time" datatype="real" name="[Calculation_c_bill_any]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0"><calculation class="tableau" formula="AVG([est_transfer_fee_usd]) * [Parameters].[p_recipients]" /></column><column caption="Monthly fee bill: send at the day's cheapest hour" datatype="real" name="[Calculation_c_bill_cheap]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0"><calculation class="tableau" formula="AVG([Calculation_c_cheapest_hour_fee]) * [Parameters].[p_recipients]" /></column><column caption="Yearly saving from timing payouts" datatype="real" name="[Calculation_c_saving_year]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0"><calculation class="tableau" formula="(AVG([est_transfer_fee_usd]) - AVG([Calculation_c_cheapest_hour_fee])) * [Parameters].[p_recipients] * 12" /></column><column caption="Fee as % of payout (send any time)" datatype="real" name="[Calculation_c_fee_pct_payout]" role="measure" type="quantitative" default-format="p0.00%"><calculation class="tableau" formula="AVG([est_transfer_fee_usd]) / [Parameters].[p_payout]" /></column><column caption="Fee as % of payout (cheapest hour)" datatype="real" name="[Calculation_c_fee_pct_payout_cheap]" role="measure" type="quantitative" default-format="p0.00%"><calculation class="tableau" formula="AVG([Calculation_c_cheapest_hour_fee]) / [Parameters].[p_payout]" /></column><column caption="In Dencun window" datatype="boolean" name="[Calculation_c_dencun_window]" role="dimension" type="nominal"><calculation class="tableau" formula="[hour_ts] &gt;= #2023-12-11# AND [hour_ts] &lt; #2024-06-17#" /></column><column caption="Small P2P (index, pre-Dencun avg = 1)" datatype="real" name="[Calculation_c_small_index]" role="measure" type="quantitative" default-format="#,##0.00"><calculation class="tableau" formula="SUM([p2p_small_transfers]) / (MIN({FIXED : SUM(IF [hour_ts] &gt;= #2023-12-11# AND [hour_ts] &lt; #2024-03-11# THEN [p2p_small_transfers] END)}) / 13)" /></column><column caption="Large P2P (index, pre-Dencun avg = 1)" datatype="real" name="[Calculation_c_large_index]" role="measure" type="quantitative" default-format="#,##0.00"><calculation class="tableau" formula="SUM([p2p_large_transfers]) / (MIN({FIXED : SUM(IF [hour_ts] &gt;= #2023-12-11# AND [hour_ts] &lt; #2024-03-11# THEN [p2p_large_transfers] END)}) / 13)" /></column></datasource><datasource caption="Activation funnel" inline="true" name="federated.activationfunnel" version="18.1"><connection class="federated"><named-connections><named-connection caption="activation_funnel" name="textscan.activationfunnel"><connection class="textscan" directory="Data/extracts" filename="activation_funnel.csv" password="" server="" /></named-connection></named-connections><relation connection="textscan.activationfunnel" name="activation_funnel.csv" table="[activation_funnel#csv]" type="table"><columns character-set="UTF-8" header="yes" locale="en_US" separator=","><column datatype="date" name="cohort_month" ordinal="0" /><column datatype="string" name="primary_token" ordinal="1" /><column datatype="string" name="first_receive_band" ordinal="2" /><column datatype="integer" name="new_wallets" ordinal="3" /><column datatype="real" name="sent_within_7d" ordinal="4" /><column datatype="real" name="sent_within_30d" ordinal="5" /><column datatype="real" name="active_month_1" ordinal="6" /><column datatype="real" name="active_month_3" ordinal="7" /><column datatype="string" name="month_3_observed" ordinal="8" /></columns></relation><metadata-records><metadata-record class="column"><remote-name>cohort_month</remote-name><remote-type>133</remote-type><local-name>[cohort_month]</local-name><parent-name>[activation_funnel.csv]</parent-name><remote-alias>cohort_month</remote-alias><ordinal>0</ordinal><local-type>date</local-type><aggregation>Count</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>primary_token</remote-name><remote-type>129</remote-type><local-name>[primary_token]</local-name><parent-name>[activation_funnel.csv]</par