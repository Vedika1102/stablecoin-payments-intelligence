<workbook original-version="18.1" source-build="2023.3.0 (20233.23.0905.1512)" source-platform="win" version="18.1" xmlns:user="http://www.tableausoftware.com/xml/user"><preferences /><datasources><datasource hasconnection="false" inline="true" name="Parameters" version="18.1"><aliases enabled="yes" /><column caption="Recipients paid per month" datatype="integer" name="[p_recipients]" role="measure" type="quantitative" value="50000" default-format="#,##0" param-domain-type="range"><calculation class="tableau" formula="50000" /><range granularity="1000" max="1000000" min="1000" /></column><column caption="Average payout ($)" datatype="real" name="[p_payout]" role="measure" type="quantitative" value="200" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0" param-domain-type="range"><calculation class="tableau" formula="200" /><range granularity="10" max="5000" min="10" /></column></datasource><datasource caption="Payment mix (daily)" inline="true" name="federated.paymentmixdaily" version="18.1"><connection class="federated"><named-connections><named-connection caption="payment_mix_daily" name="textscan.paymentmixdaily"><connection class="textscan" directory="Data/extracts" filename="payment_mix_daily.csv" password="" server="" /></named-connection></named-connections><relation connection="textscan.paymentmixdaily" name="payment_mix_daily.csv" table="[payment_mix_daily#csv]" type="table"><columns character-set="UTF-8" header="yes" locale="en_US" separator=","><column datatype="date" name="activity_date" ordinal="0" /><column datatype="string" name="protocol_era" ordinal="1" /><column datatype="string" name="token_symbol" ordinal="2" /><column datatype="string" name="flow_category" ordinal="3" /><column datatype="real" name="transfers" ordinal="4" /><column datatype="real" name="volume_usd" ordinal="5" /><column datatype="real" name="avg_median_fee_usd" ordinal="6" /></columns></relation><metadata-records><metadata-record class="column"><remote-name>activity_date</