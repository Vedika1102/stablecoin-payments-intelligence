rdinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>avg_median_fee_usd</remote-name><remote-type>5</remote-type><local-name>[avg_median_fee_usd]</local-name><parent-name>[payment_mix_daily.csv]</parent-name><remote-alias>avg_median_fee_usd</remote-alias><ordinal>6</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record></metadata-records></connection><aliases enabled="yes" /><column caption="Activity date" datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column caption="Protocol era" datatype="string" name="[protocol_era]" role="dimension" type="nominal" /><column caption="Token symbol" datatype="string" name="[token_symbol]" role="dimension" type="nominal" /><column caption="Flow category" datatype="string" name="[flow_category]" role="dimension" type="nominal" /><column caption="Transfers" datatype="real" name="[transfers]" role="measure" type="quantitative" /><column caption="Volume usd" datatype="real" name="[volume_usd]" role="measure" type="quantitative" /><column caption="Avg median fee usd" datatype="real" name="[avg_median_fee_usd]" role="measure" type="quantitative" /><column caption="Flow label" datatype="string" name="[Calculation_c_flow_label]" role="dimension" type="nominal"><calculation class="tableau" formula="CASE [flow_category] WHEN &quot;p2p_small_ticket&quot; THEN &quot;P2P under $1K&quot; WHEN &quot;p2p_large_ticket&quot; THEN &quot;P2P $1K+&quot; WHEN &quot;contract_flow&quot; THEN &quot;Contract flows&quot; WHEN &quot;dust_spam&quot; THEN &quot;Dust / spam&quot; ELSE &quot;Mint / burn&quot; END" /></column><column caption="Transfers (M, ex spam)" datatype="real" name="[Calculation_c_tx_ex_spam_m]" role="measure" type="quantitative" default-format="*#,##0.0&quot;M&quot;"><calculation class="tableau" formula="SUM(IF [flow_category] != &quot;dust_spam&quot; THEN [transfers] END) / 1000000" /></column><column caption="Volume ($T, ex spam)" datatype="real" name="[Calculation_c_vol_t]" role="measure" type="quantitative" default-format="*&quot;$&quot;#,##0.0&quot;T&quot;"><calculation class="tableau" formula="SUM(IF [flow_category] != &quot;dust_spam&quot; THEN [volume_usd] END) / 1000000000000" /></column><column caption="Payment-like share" datatype="real" name="[Calculation_c_pay_share]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM(IF [flow_category] = &quot;p2p_small_ticket&quot; THEN [transfers] END) / SUM(IF [flow_category] != &quot;dust_spam&quot; THEN [transfers] END)" /></column><column caption="Share of transfers" datatype="real" name="[Calculation_c_share_tx]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM([transfers]) / MIN({EXCLUDE [flow_category] : SUM([transfers])})" /></column><column caption="Share of value" datatype="real" name="[Calculation_c_share_vol]" role="measure" type="quantitative" default-format="p0.0%"><calculation class="tableau" formula="SUM([volume_usd]) / MIN({EXCLUDE [flow_category] : SUM([volume_usd])})" /></column><column caption="Share of all transfers" datatype="real" name="[Calculation_c_share_tx_all]" role="measure" type="quantitative" default-format="p0.0%"><calculation class="tableau" formula="SUM([transfers]) / MIN({FIXED : SUM([transfers])})" /></column><column caption="Share of all value" datatype="real" name="[Calculation_c_share_vol_all]" role="measure" type="quantitative" default-format="p0.00%"><calculation class="tableau" formula="SUM([volume_usd]) / MIN({FIXED : SUM([volume_usd])})" /></column><style><style-rule element="mark"><encoding attr="color" field="[Calculation_c_flow_label]" type="palette"><map to="#257de0"><bucket>"P2P under $1K"</bucket></map><map to="#f47230"><bucket>"P2P $1K+"</bucket></map><map to="#00b894"><bucket>"Contract flows"</bucket></map><map to="#f2a600"><bucket>"Mint / burn"</bucket></map><map to="#e87ba4"><bucket>"Dust / spam"</bucket></map></encoding></style-rule></style></datasource><datasource caption="Network fees (daily)" inline="true" name="federated.networkdaily" version="18.1"><connection class="federated"><named-connections><named-connection caption="network_daily" name="textscan.networkdaily"><connection class="textscan" directory="Data/extracts" filename="network_daily.csv" password="" server="" /></named-connection></named-connections><relation connection="textscan.networkdaily" name="network_daily.csv" table="[network_daily#csv]" type="table"><columns character-set="UTF-8" header="yes" locale="en_US" separator=","><column datatype="date" name="activity_date" ordinal="0" /><column datatype="string" name="protocol_era" ordinal="1" /><column datatype="real" name="avg_base_fee_gwei" ordinal="2" /><column datatype="real" name="eth_usd" ordinal="3" /><column datatype="real" name="est_transfer_fee_usd" ordinal="4" /><column datatype="real" name="network_tx_count" ordinal="5" /></columns></relation><metadata-records><metadata-record class="column"><remote-name>activity_date</remote-name><remote-type>133</remote-type><local-name>[activity_date]</local-name><parent-name>[network_daily.csv]</parent-name><remote-alias>activity_date</remote-alias><ordinal>0</ordinal><local-type>date</local-type><aggregation>Count</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>protocol_era</remote-name><remote-type>129</remote-type><local-name>[protocol_era]</local-name><parent-name>[network_daily.csv]</parent-name><remote-alias>protocol_era</remote-alias><ordinal>1</ordinal><local-type>string</local-type><aggregation>Count</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>avg_base_fee_gwei</remote-name><remote-type>5</remote-type><local-name>[avg_base_fee_gwei]</local-name><parent-name>[network_daily.csv]</parent-name><remote-alias>avg_base_fee_gwei</remote-alias><ordinal>2</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>eth_usd</remote-name><remote-type>5</remote-type><local-name>[eth_usd]</local-name><parent-name>[network_daily.csv]</parent-name><remote-alias>eth_usd</remote-alias><ordinal>3</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>est_transfer_fee_usd</remote-name><remote-type>5</remote-type><local-name>[est_transfer_fee_usd]</local-name><parent-name>[network_daily.csv]</parent-name><remote-alias>est_transfer_fee_usd</remote-alias><ordinal>4</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record><metadata-record class="column"><remote-name>network_tx_count</remote-name><remote-type>5</remote-type><local-name>[network_tx_count]</local-name><parent-name>[network_daily.csv]</parent-name><remote-alias>network_tx_count</remote-alias><ordinal>5</ordinal><local-type>real</local-type><aggregation>Sum</aggregation><contains-null>true</contains-null></metadata-record></metadata-records></connection><aliases enabled="yes" /><column caption="Activity date" datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column caption="Protocol era" datatype="string" name="[protocol_era]" role="dimension" type="nominal" /><column caption="Avg base fee gwei" datatype="real" name="[avg_base_fee_gwei]" role="measure" type="quantitative" /><column caption="Eth usd" datatype="real" name="[eth_usd]" role="measure" type="quantitative" /><column caption="Est transfer fee usd" datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column caption="Network tx count" datatype="real" name="[network_tx_count]" role="measure" type="quantitative" /><column caption="Median fee per transfer, last 12 months" datatype="real" name="[Calculation_c_fee_med_12m]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="MEDIAN(IF [activity_date] &gt;= #2024-07-01# THEN [est_transfer_fee_usd] END)" /></column></datasource><datasource caption="Fees and payments (hourly)" inline="true" name="federated.feehourlypanel" version="18.1"><connection class="federated"><named-connections><named-connection caption="fee_hourly_panel" name="textscan.feehourlypanel"><connection class="textscan" directory="Data/extracts" filename="fee_hourly_panel.csv" password="" server="" /></named-connection></named-connections><relation connection="textscan.feehourlypanel" name="fee_hourly_panel.csv" table="[fee_hourly_panel#csv]" type="table"><columns character-set="UTF-8" header="yes" locale="en_US" separator=","><column datatype="datetime" name="hour_ts" ordinal="0" /><column datatype="date" name="activity_date" ordinal="1" /><column datatype="integer" name="hour_of_day" ordinal="2" /><column datatype="integer" name="day_of_week" ordinal="3" /><column datatype="string" name="protocol_era" ordinal="4" /><column datatype="real" name="avg_base_fee_gwei" ordinal="5" /><column datatype="real" name="avg_block_utilization" ordinal="6" /><column datatype="integer" name="network_tx_count" ordinal="7" /><column datatype="integer" name="blocks" ordinal="8" /><column datatype="real" name="eth_usd" ordinal="9" /><column datatype="integer" name="oracle_swaps" ordinal="10" /><column datatype="real" name="est_transfer_fee_usd" ordinal="11" /><column datatype="real" name="p2p_small_transfers" ordinal="12" /><column datatype="real" name="p2p_large_transfers" ordinal="13" /><column datatype="real" name="p2p_micro_transfers" ordinal="14" /><column datatype="real" name="p2p_transfers" ordinal="15" /><column datatype="real" name="p2p_volume_usd" ordinal="16" /></col