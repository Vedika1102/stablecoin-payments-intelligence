sheet name="KPI Payment share"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></title></layout-options><table><view><datasources><datasource caption="Payment mix (daily)" name="federated.paymentmixdaily" /></datasources><datasource-dependencies datasource="federated.paymentmixdaily"><column datatype="string" name="[flow_category]" role="dimension" type="nominal" /><column datatype="real" name="[transfers]" role="measure" type="quantitative" /><column caption="Payment-like share" datatype="real" name="[Calculation_c_pay_share]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM(IF [flow_category] = &quot;p2p_small_ticket&quot; THEN [transfers] END) / SUM(IF [flow_category] != &quot;dust_spam&quot; THEN [transfers] END)" /></column><column-instance column="[Calculation_c_pay_share]" derivation="User" name="[usr:Calculation_c_pay_share:qk]" pivot="key" type="quantitative" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Text" /><encodings><text column="[federated.paymentmixdaily].[usr:Calculation_c_pay_share:qk]" /></encodings></pane></panes><rows /><cols /></table></worksheet><worksheet name="KPI Fee"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></title></layout-options><table><view><datasources><datasource caption="Network fees (daily)" name="federated.networkdaily" /></datasources><datasource-dependencies datasource="federated.networkdaily"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column caption="Median fee per transfer, last 12 months" datatype="real" name="[Calculation_c_fee_med_12m]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="MEDIAN(IF [activity_date] &gt;= #2024-07-01# THEN [est_transfer_fee_usd] END)" /></column><column-instance column="[Calculation_c_fee_med_12m]" derivation="User" name="[usr:Calculation_c_fee_med_12m:qk]" pivot="key" type="quantitative" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Text" /><encodings><text column="[federated.networkdaily].[usr:Calculation_c_fee_med_12m:qk]" /></encodings></pane></panes><rows /><cols /></table></worksheet><worksheet name="KPI Activation"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></title></layout-options><table><view><datasources><datasource caption="Activation funnel" name="federated.activationfunnel" /></datasources><datasource-dependencies datasource="federated.activationfunnel"><column datatype="integer" name="[new_wallets]" role="measure" type="quantitative" /><column datatype="real" name="[sent_within_7d]" role="measure" type="quantitative" /><column caption="Activation (sent within 7 days)" datatype="real" name="[Calculation_c_act7]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM([sent_within_7d]) / SUM([new_wallets])" /></column><column-instance column="[Calculation_c_act7]" derivation="User" name="[usr:Calculation_c_act7:qk]" pivot="key" type="quantitative" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Text" /><encodings><text column="[federated.activationfunnel].[usr:Calculation_c_act7:qk]" /></encodings></pane></panes><rows /><cols /></table></worksheet><worksheet name="KPI Retention"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></ti