olumn="[Calculation_c_small_share]" derivation="User" name="[usr:Calculation_c_small_share:qk]" pivot="key" type="quantitative" /><column-instance column="[est_transfer_fee_usd]" derivation="Avg" name="[avg:est_transfer_fee_usd:qk]" pivot="key" type="quantitative" /><column-instance column="[hour_ts]" derivation="None" name="[none:hour_ts:nk]" pivot="key" type="nominal" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Circle" /><encodings><lod column="[federated.feehourlypanel].[none:hour_ts:nk]" /></encodings></pane></panes><rows>[federated.feehourlypanel].[usr:Calculation_c_small_share:qk]</rows><cols>[federated.feehourlypanel].[avg:est_transfer_fee_usd:qk]</cols></table></worksheet><worksheet name="Dencun small vs large"><layout-options><title><formatted-text><run bold="true" fontsize="13">Small and large P2P transfers around Dencun, weekly, indexed to the pre-period</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Fees and payments (hourly)" name="federated.feehourlypanel" /></datasources><datasource-dependencies datasource="federated.feehourlypanel"><column datatype="datetime" name="[hour_ts]" role="dimension" type="quantitative" /><column datatype="real" name="[p2p_large_transfers]" role="measure" type="quantitative" /><column datatype="real" name="[p2p_small_transfers]" role="measure" type="quantitative" /><column caption="In Dencun window" datatype="boolean" name="[Calculation_c_dencun_window]" role="dimension" type="nominal"><calculation class="tableau" formula="[hour_ts] &gt;= #2023-12-11# AND [hour_ts] &lt; #2024-06-17#" /></column><column caption="Small P2P (index, pre-Dencun avg = 1)" datatype="real" name="[Calculation_c_small_index]" role="measure" type="quantitative" default-format="#,##0.00"><calculation class="tableau" formula="SUM([p2p_small_transfers]) / (MIN({FIXED : SUM(IF [hour_ts] &gt;= #2023-12-11# AND [hour_ts] &lt; #2024-03-11# THEN [p2p_small_transfers] END)}) / 13)" /></column><column caption="Large P2P (index, pre-Dencun avg = 1)" datatype="real" name="[Calculation_c_large_index]" role="measure" type="quantitative" default-format="#,##0.00"><calculation class="tableau" formula="SUM([p2p_large_transfers]) / (MIN({FIXED : SUM(IF [hour_ts] &gt;= #2023-12-11# AND [hour_ts] &lt; #2024-03-11# THEN [p2p_large_transfers] END)}) / 13)" /></column><column-instance column="[Calculation_c_small_index]" derivation="User" name="[usr:Calculation_c_small_index:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_large_index]" derivation="User" name="[usr:Calculation_c_large_index:qk]" pivot="key" type="quantitative" /><column-instance column="[hour_ts]" derivation="Week-Trunc" name="[twk:hour_ts:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_dencun_window]" derivation="None" name="[none:Calculation_c_dencun_window:nk]" pivot="key" type="nominal" /></datasource-dependencies><filter class="categorical" column="[federated.feehourlypanel].[none:Calculation_c_dencun_window:nk]"><groupfilter function="member" level="[none:Calculation_c_dencun_window:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" /></filter><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Line" /><encodings /></pane></panes><rows>([federated.feehourlypanel].[usr:Calculation_c_small_index:qk] / [federated.feehourlypanel].[usr:Calculation_c_large_index:qk])</rows><cols>[federated.feehourlypanel].[twk:hour_ts:qk]</cols></table></worksheet><worksheet name="Cohort heatmap"><layout-options><title><formatted-text><run bold="true" fontsize="13">Share of each monthly cohort still active N months later</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Cohort retention" name="federated.cohortretention" /></datasources><datasource-dependencies datasource="federated.cohortretention"><column datatype="integer" name="[active_wallets]" role="measure" type="quantitative" /><column datatype="date" name="[cohort_month]" role="dimension" type="quantitative" /><column datatype="integer" name="[cohort_size]" role="measure" type="quantitative" /><column datatype="integer" name="[months_since_start]" role="dimension" type="ordinal" /><column caption="Retention" datatype="real" name="[Calculation_c_retention]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="IF MIN([months_since_start]) &gt; 0 THEN SUM([active_wallets]) / SUM([cohort_size]) END" /></column><column-instance column="[cohort_month]" derivation="Month-Trunc" name="[tmn:cohort_month:ok]" pivot="key" type="ordinal" /><column-instance column="[months_since_start]" derivation="None" name="[none:months_since_start:ok]" pivot="key" type="ordinal" /><column-instance column="[Calculation_c_retention]" derivation="User" name="[usr:Calculation_c_retention:qk]" pivot="key" type="quantitative" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Square" /><encodings><color column="[federated.cohortretention].[usr:Calculation_c_retention:qk]" /><text column="[federated.cohortretention].[usr:Calculation_c_retention:qk]" /></encodings></pane></panes><rows>[federated.cohortretention].[tmn:cohort_month:ok]</rows><cols>[federated.cohortretention].[none:months_since_start:ok]</cols></table></worksheet><worksheet name="Retention by first receipt"><layout-options><title><formatted-text><run bold="true" fontsize="13">Wallets whose first receipt is $100+ retain better (month-3 retention)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Activation funnel" name="federated.activationfunnel" /></datasources><datasource-dependencies datasource="federated.activationfunnel"><column datatype="real" name="[active_month_3]" role="measure" type="quantitative" /><column datatype="string" name="[first_receive_band]" role="dimension" type="nominal" /><column datatype="string" name="[month_3_observed]" role="dimension" type="nominal" /><column datatype="integer" name="[new_wallets]" role="measure" type="quantitative" /><column datatype="string" name="[primary_token]" role="dimension" type="nominal" /><column caption="Month-3 retention" datatype="real" name="[Calculation_c_ret_m3]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM(IF [month_3_observed] = &quot;True&quot; THEN [active_month_3] END) / SUM(IF [month_3_observed] = &quot;True&quot; THEN [new_wallets] END)" /></column><column caption="First receipt" datatype="string" name="[Calculation_c_band]" role="dimension" type="nominal"><calculation class="tableau" formula="CASE [first_receive_band] WHEN &quot;under_$100&quot; THEN &quot;1 Under $100&quot; WHEN &quot;$100-1K&quot; THEN &quot;2 $100 to $1K&quot; WHEN &quot;$1K-10K&quot; THEN &quot;3 $1K to $10K&quot; ELSE &quot;4 $10K+&quot; END" /></column><column-instance column="[Calculation_c_band]" derivation="None" name="[none:Calculation_c_band:nk]" pivot="key" type="nominal" /><column-instance column="[Calculation_c_ret_m3]" derivation="User" name="[usr:Calculation_c_ret_m3:qk]" pivot="key" type="quantitative" /><column-instance column="[primary_token]" derivation="None" name="[none:primary_token:nk]" pivot="key" type="nominal" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Bar" /><encodings><color column="[federated.activationfunnel].[none:primary_token:nk]" /></encodings></pane></panes><rows>[federated.activationfunnel].[none:Calculation_c_band:nk]</rows><cols>[federated.activationfunnel].[usr:Calculation_c_ret_m3:qk]</cols></table></worksheet><worksheet name="Activation by first receipt"><layout-options><title><formatted-text><run bold="true" fontsize="13">Activation (sent within 7 days) by first receipt and token</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Activation funnel" name="federated.activationfunnel" /></datasources><datasource-dependencies datasource="federated.activationfunnel"><column datatype="string" name="[first_receive_band]" role="dimension" type="nominal" /><column datatype="integer" name="[new_wallets]" role="measure" type="quantitative" /><column datatype="string" name="[primary_token]" role="dimension" type="nominal" /><column datatype="real" name="[sent_within_7d]" role="measure" type="quantitative" /><column caption="Activation (sent within 7 days)" datatype="real" name="[Calculation_c_act7]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM([sent_within_7d]) / SUM([new_wallets])" /></column><column caption="First receipt" datatype="string" name="[Calculation_c_band]" role="dimension" type="nominal"><calculation class="tableau" formula="CASE [first_receive_band] WHEN &quot;under_$100&quot; THEN &quot;1 Under $100&quot; WHEN &quot;$100-1K&quot; THEN &quot;2 $100 to $1K&quot; WHEN &quot;$1K-10K&quot; THEN &quot;3 $1K to $10K&quot; ELSE &quot;4 $10K+&quot; END" /></column><column-instance column="[Calculation_c_band]" derivation="None" name="[none:Calculation_c_band:nk]" pivot="key" type="nominal" /><column-instance column="[Calculation_c_act7]" derivation="User" name="[usr:Calculation_c_act7:qk]" pivot="key" type="quantitative" /><column-instance column="[primary_token]" derivation="None" name="[none:primary_token:nk]" pivot="key" type="nominal" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Bar" /><encodings><color column="[federated.activationfunnel].[none:primary_token:nk]" /></encodings></pane></panes><rows>[federated.activationfunnel].[none:Calculation_c_band:nk]</rows><cols>[federated.activationfunnel].[usr:Calculation_c_act7:qk]</cols></table></worksheet><worksheet name="DQ checks"><layout-options><title><formatted-text><run bold="true" fontsize="13">Automated data quality checks by layer (all passing)</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Data quality checks" name="federated.dqsummary" /></datasources><datasource-dependencies datasource="federated.dqsummary"><column datatype="string" name="[check_name]" role="dimension" type="nominal" /><column datatype="string" name="[dataset]" role="dimension" type="nominal" /><column datatype="string" name="[passed]" role="dimension" type="nominal" /><column datatype="string" name="[severity]" role="dimension" type="nominal" /><column caption="Status" datatype="string" name="[Calculation_c_status]" role="dimension" type="nominal"><calculation class="tableau" formula="IF [passed] = &quot;True&quot; THEN &quot;Pass&quot; ELSEIF [severity] = &quot;warn&quot; THEN &quot;Warn&quot; ELSE &quot;Fail&quot; END" /></column><column caption="Checks" datatype="integer" name="[Calculation_c_checks]" role="measure" type="quantitative" default-format="#,##0"><calculation class="tableau" formula="COUNT([check_name])" /></column><column-instance column="[dataset]" derivation="None" name="[none:dataset:nk]" pivot="key" type="nominal" /><column-instance column="[Calculation_c_checks]" derivation="User" name="[usr:Calculation_c_checks:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_status]" derivation="None" name="[none:Calculation_c_status:nk]" pivot="key" type="nominal" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Bar" /><encodings><color column="[federated.dqsummary].[none:Calculation_c_status:nk]" /></encodings></pane></panes><rows>[federated.dqsummary].[none:dataset:nk]</rows><cols>[federated.dqsummary].[usr:Calculation_c_checks:qk]</cols></table></worksheet><worksheet name="Cheapest hours heatmap"><layout-options><title><formatted-text><run bold="true" fontsize="13">Median fee per transfer by day and hour (UTC, last 12 months): lighter is cheaper</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Fees and payments (hourly)" name="federated.feehourlypanel" /></datasources><datasource-dependencies datasource="federated.feehourlypanel"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column datatype="integer" name="[hour_of_day]" role="dimension" type="ordinal" /><column datatype="datetime" name="[hour_ts]" role="dimension" type="quantitative" /><column caption="Day of week (UTC)" datatype="string" name="[Calculation_c_weekday]" role="dimension" type="nominal"><calculation class="tableau" formula="STR(DATEPART('weekday', [hour_ts])) + ' ' + DATENAME('weekday', [hour_ts])" /></column><column caption="Last 12 months" datatype="boolean" name="[Calculation_c_last12]" role="dimension" type="nominal"><calculation class="tableau" formula="[activity_date] &gt;= #2024-07-01#" /></column><column caption="Median fee per transfer" datatype="real" name="[Calculation_c_fee_med]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="MEDIAN([est_transfer_fee_usd])" /></column><column-instance column="[Calculation_c_weekday]" derivation="None" name="[none:Calculation_c_weekday:nk]" pivot="key" type="nominal" /><column-instance column="[hour_of_day]" derivation="None" name="[none:hour_of_day:ok]" pivot="key" type="ordinal" /><column-instance column="[Calculation_c_fee_med]" derivation="User" name="[usr:Calculation_c_fee_med:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_last12]" derivation="None" name="[none:Calculation_c_last12:nk]" pivot="key" type="nominal" /></datasource-dependencies><filter class="categorical" column="[federated.feehourlypanel].[none:Calculation_c_last12:nk]"><groupfilter function="member" level="[none:Calculation_c_last12:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" /></filter><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Square" /><encodings><color column="[federated.feehourlypanel].[usr:Calculation_c_fee_med:qk]" /><text column="[federated.feehourlypanel].[usr:Calculation_c_fee_med:qk]" /></encodings></pane></panes><rows>[federated.feehourlypanel].[none:Calculation_c_weekday:nk]</rows><cols>[federated.feehourlypanel].[none:hour_of_day:ok]</cols></table></worksheet><worksheet name="Monthly fee bill"><layout-options><title><formatted-text><run bold="true" fontsize="13">Monthly network fee bill for your payouts: any time vs the day's cheapest hour</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Fees and payments (hourly)" name="federated.feehourlypanel" /><datasource name="Parameters" /></datasources><datasource-dependencies datasource="Parameters"><column caption="Recipients paid per month" datatype="integer" name="[p_recipients]" role="measure" type="quantitative" value="50000" param-domain-type="range"><calculation class="tableau" formula="50000" /><range granularity="1000" max="1000000" min="1000" /></column></datasource-dependencies><datasource-dependencies datasource="federated.feehourlypanel"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column datatype="datetime" name="[hour_ts]" role="dimension" type="quantitative" /><column caption="Cheapest hour of the day: fee" datatype="real" name="[Calculation_c_cheapest_hour_fee]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="{FIXED [activity_date] : MIN([est_transfer_fee_usd])}" /></column><column caption="Monthly fee bill: send any time" datatype="real" name="[Calculation_c_bill_any]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0"><calculation class="tableau" formula="AVG([est_transfer_fee_usd]) * [Parameters].[p_recipients]" /></column><column caption="Monthly fee bill: send at the day's cheapest hour" datatype="real" name="[Calculation_c_bill_cheap]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0"><calculation class="tableau" formula="AVG([Calculation_c_cheapest_hour_fee]) * [Parameters].[p_recipients]" /></column><column-instance column="[Calculation_c_bill_any]" derivation="User" name="[usr:Calculation_c_bill_any:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_bill_cheap]" derivation="User" name="[usr:Calculation_c_bill_cheap:qk]" pivot="key" type="quantitative" /><column-instance column="[hour_ts]" derivation="Month-Trunc" name="[tmn:hour_ts:ok]" pivot="key" type="ordinal" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Bar" /><encodings /></pane></panes><rows>([federated.feehourlypanel].[usr:Calculation_c_bill_any:qk] / [federated.feehourlypanel].[usr:Calculation_c_bill_cheap:qk])</rows><cols>[federated.feehourlypanel].[tmn:hour_ts:ok]</cols></table></worksheet><worksheet name="KPI Saving"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></title></layout-options><table><view><datasources><datasource caption="Fees and payments (hourly)" name="federated.feehourlypanel" /><datasource name="Parameters" /></datasources><datasource-dependencies datasource="Parameters"><column caption="Recipients paid per month" datatype="integer" name="[p_recipients]" role="measure" type="quantitative" value="50000" param-domain-type="range"><calculation class="tableau" formula="50000" /><range granularity="1000" max="1000000" min="1000" /></column></datasource-dependencies><datasource-dependencies datasource="federated.feehourlypanel"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column caption="Last 12 months" datatype="boolean" name="[Calculation_c_last12]" role="dimension" type="nominal"><calculation class="tableau" formula="[activity_date] &gt;= #2024-07-01#" /></column><column caption="Cheapest hour of the day: fee" datatype="real" name="[Calculation_c_cheapest_hour_fee]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="{FIXED [activity_date] : MIN([est_transfer_fee_usd])}" /></column><column caption="Yearly saving from timing payouts" datatype="real" name="[Calculation_c_saving_year]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0;-&quot;$&quot;#,##0"><calculation class="tableau" formula="(AVG([est_transfer_fee_usd]) - AVG([Calculation_c_cheapest_hour_fee])) * [Parameters].[p_recipients] * 12" /></column><column-instance column="[Calculation_c_saving_year]" derivation="User" name="[usr:Calculation_c_saving_year:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_last12]" derivation="None" name="[none:Calculation_c_last12:nk]" pivot="key" type="nominal" /></datasource-dependencies><filter class="categorical" column="[federated.feehourlypanel].[none:Calculation_c_last12:nk]"><groupfilter function="member" level="[none:Calculation_c_last12:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" /></filter><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Text" /><encodings><text column="[federated.feehourlypanel].[usr:Calculation_c_saving_year:qk]" /></encodings></pane></panes><rows /><cols /></table></worksheet><worksheet name="KPI Fee pct"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></title></layout-options><table><view><datasources><datasource caption="Fees and payments (hourly)" name="federated.feehourlypanel" /><datasource name="Parameters" /></datasources><datasource-dependencies datasource="Parameters"><column caption="Average payout ($)" datatype="real" name="[p_payout]" role="measure" type="quantitative" value="200" param-domain-type="range"><calculation class="tableau" formula="200" /><range granularity="10" max="5000" min="10" /></column></datasource-dependencies><datasource-dependencies datasource="federated.feehourlypanel"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column caption="Last 12 months" datatype="boolean" name="[Calculation_c_last12]" role="dimension" type="nominal"><calculation class="tableau" formula="[activity_date] &gt;= #2024-07-01#" /></column><column caption="Fee as % of payout (send any time)" datatype="real" name="[Calculation_c_fee_pct_payout]" role="measure" type="quantitative" default-format="p0.00%"><calculation class="tableau" formula="AVG([est_transfer_fee_usd]) / [Parameters].[p_payout]" /></column><column-instance column="[Calculation_c_fee_pct_payout]" derivation="User" name="[usr:Calculation_c_fee_pct_payout:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_last12]" derivation="None" name="[none:Calculation_c_last12:nk]" pivot="key" type="nominal" /></datasource-dependencies><filter class="categorical" column="[federated.feehourlypanel].[none:Calculation_c_last12:nk]"><groupfilter function="member" level="[none:Calculation_c_last12:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" /></filter><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Text" /><encodings><text column="[federated.feehourlypanel].[usr:Calculation_c_fee_pct_payout:qk]" /></encodings></pane></panes><rows /><cols /></table></worksheet><worksheet name="KPI Fee pct cheap"><layout-options><title><formatted-text><run bold="true" fontsize="13" /></formatted-text></title></layout-options><table><view><datasources><datasource caption="Fees and payments (hourly)" name="federated.feehourlypanel" /><datasource name="Parameters" /></datasources><datasource-dependencies datasource="Parameters"><column caption="Average payout ($)" datatype="real" name="[p_payout]" role="measure" type="quantitative" value="200" param-domain-type="range"><calculation class="tableau" formula="200" /><range granularity="10" max="5000" min="10" /></column></datasource-dependencies><datasource-dependencies datasource="federated.feehourlypanel"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="real" name="[est_transfer_fee_usd]" role="measure" type="quantitative" /><column caption="Last 12 months" datatype="boolean" name="[Calculation_c_last12]" role="dimension" type="nominal"><calculation class="tableau" formula="[activity_date] &gt;= #2024-07-01#" /></column><column caption="Cheapest hour of the day: fee" datatype="real" name="[Calculation_c_cheapest_hour_fee]" role="measure" type="quantitative" default-format="c&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00"><calculation class="tableau" formula="{FIXED [activity_date] : MIN([est_transfer_fee_usd])}" /></column><column caption="Fee as % of payout (cheapest hour)" datatype="real" name="[Calculation_c_fee_pct_payout_cheap]" role="measure" type="quantitative" default-format="p0.00%"><calculation class="tableau" formula="AVG([Calculation_c_cheapest_hour_fee]) / [Parameters].[p_payout]" /></column><column-instance column="[Calculation_c_fee_pct_payout_cheap]" derivation="User" name="[usr:Calculation_c_fee_pct_payout_cheap:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_last12]" derivation="None" name="[none:Calculation_c_last12:nk]" pivot="key" type="nominal" /></datasource-dependencies><filter class="categorical" column="[federated.feehourlypanel].[none:Calculation_c_last12:nk]"><groupfilter function="member" level="[none:Calculation_c_last12:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" /></filter><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Text" /><encodings><text column="[federated.feehourlypanel].[usr:Calculation_c_fee_pct_payout_cheap:qk]" /></encodings></pane></panes><rows /><cols /></table></worksheet></worksheets><dashboards><dashboard name="1 Executive overview"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">Executive overview</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: is stablecoin payment usage real, and is it growing?</run></formatted-text></zone><zone floating="true" id="13" name="KPI Transfers" x="1666" y="11000" w="15000" h="6875" show-title="false" /><zone floating="true" id="14" x="1666" y="17750" w="15000" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">stablecoin transfers (ex spam)</run></formatted-text></zone><zone floating="true" id="15" name="KPI Volume" x="17750" y="11000" w="15000" h="6875" show-title="false" /><zone floating="true" id="16" x="17750" y="17750" w="15000" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">value moved</run></formatted-text></zone><zone floating="true" id="17" name="KPI Payment share" x="33833" y="11000" w="15000" h="6875" show-title="false" /><zone floating="true" id="18" x="33833" y="17750" w="15000" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">of transfers are payments under $1K</run></formatted-text></zone><zone floating="true" id="19" name="KPI Fee" x="49916" y="11000" w="15000" h="6875" show-title="false" /><zone floating="true" id="20" x="49916" y="17750" w="15000" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">median fee per transfer, last 12 months</run></formatted-text></zone><zone floating="true" id="21" name="KPI Activation" x="66000" y="11000" w="15000" h="6875" show-title="false" /><zone floating="true" id="22" x="66000" y="17750" w="15000" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">of new wallets send within 7 days</run></formatted-text></zone><zone floating="true" id="23" name="KPI Retention" x="82083" y="11000" w="15000" h="6875" show-title="false" /><zone floating="true" id="24" x="82083" y="17750" w="15000" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">of new wallets active in month 3</run></formatted-text></zone><zone floating="true" id="25" name="Payment share trend" x="1666" y="25000" w="96666" h="45000" /><zone floating="true" id="26" x="1666" y="71875" w="96666" h="22500" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="12" bold="true">What this means: </run><run fontcolor="#1f2d3d" fontsize="12">Stablecoin payments on Ethereum are real and steady, about 3 in 10 transfers, but they are a rounding error in value (0.07% of dollars moved). The share falls when network fees spike (late 2023, March 2024) and recovers when fees fall. 71% of new wallets 'activate', but most of them are pass-through addresses, which is why month-3 retention is low. See the Lifecycle dashboard before setting an activation target.</run></formatted-text></zone><zone floating="true" id="27" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard><dashboard name="2 What stablecoins are used for"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">What stablecoins are used for</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: how much is real payments, and how much is trading and treasury?</run></formatted-text></zone><zone floating="true" id="13" name="Transfers vs value" x="1666" y="10000" w="96666" h="28749" /><zone floating="true" id="14" name="Flow mix by month" x="1666" y="40000" w="58333" h="55000" /><zone floating="true" id="15" name="Segments" x="60833" y="40000" w="37500" h="55000" /><zone floating="true" id="16" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard><dashboard name="3 Fees and small payments"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">Fees and small payments</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: do network fees decide whether small payments happen?</run></formatted-text></zone><zone floating="true" id="13" name="Daily fee" x="1666" y="10000" w="96666" h="31250" /><zone floating="true" id="14" name="Fee vs small share" x="1666" y="42500" w="63333" h="52500" /><zone floating="true" id="15" x="66666" y="43750" w="31666" h="50000" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="14" bold="true">Elasticity of small payments to fees: -0.149Æ
</run><run fontcolor="#1f2d3d" fontsize="11">95% CI -0.163 to -0.135. A 10% higher fee goes with about 1.5% fewer small transfers in that hour, holding hour-of-week and month fixed (HAC errors).Æ
Æ
</run><run fontcolor="#1f2d3d" fontsize="14" bold="true">Relative to large transfers: -0.241Æ
</run><run fontcolor="#1f2d3d" fontsize="11">Large tickets barely react. The under-$1K share of P2P falls from 62% in the cheapest hours to 47% in the most expensive decile.Æ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11" bold="true">Decision: </run><run fontcolor="#1f2d3d" fontsize="11">route payouts under $1K to the cheapest rail, and batch or delay them when fees are in the top two deciles. Use the Payout planner to size the saving.</run></formatted-text></zone><zone floating="true" id="16" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard><dashboard name="4 Natural experiment Dencun"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">Natural experiment Dencun</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: did cheaper rollups change payment behaviour on mainnet?</run></formatted-text></zone><zone floating="true" id="13" name="Dencun small vs large" x="1666" y="10000" w="63333" h="85000" /><zone floating="true" id="14" x="66666" y="11250" w="31666" h="82500" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="14" bold="true">Result: inconclusive, and we say soÆ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11">Dencun (13 Mar 2024) cut rollup costs on a known date, a natural experiment. Small tickets are the treated group, large tickets ($10K+) the control.Æ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11">Difference-in-differences: p = 0.09. Pre-period event-study coefficients drift up to 0.56 log points, and a placebo date (13 Dec 2023) shows a similar effect. Early March 2024 was a market surge that moved large tickets, so the two groups were not on parallel paths.Æ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11" bold="true">Decision: </run><run fontcolor="#1f2d3d" fontsize="11">do not plan on a Dencun effect. Rely on the fee elasticity instead.</run></formatted-text></zone><zone floating="true" id="15" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard><dashboard name="5 Wallet lifecycle"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">Wallet lifecycle</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: do new users stick, and which ones are worth acquiring?</run></formatted-text></zone><zone floating="true" id="13" name="Cohort heatmap" x="1666" y="10000" w="58333" h="85000" /><zone floating="true" id="14" name="Activation by first receipt" x="60833" y="10000" w="37500" h="41250" /><zone floating="true" id="15" name="Retention by first receipt" x="60833" y="52500" w="37500" h="42500" /><zone floating="true" id="16" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard><dashboard name="6 Data quality"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">Data quality</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: can we trust these numbers?</run></formatted-text></zone><zone floating="true" id="13" name="DQ checks" x="1666" y="10000" w="63333" h="85000" /><zone floating="true" id="14" x="66666" y="11250" w="31666" h="82500" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="14" bold="true">717 automated checks, all passingÆ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11">Every layer is checked on every run: row counts, null keys, hash and address formats, foreign keys to blocks, ETH/USD plausibility, and gold-to-silver reconciliation (exact on row count). 63 dbt models and tests pass in the warehouse.Æ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11" bold="true">Biggest catch: </run><run fontcolor="#1f2d3d" fontsize="11">11.9M address-poisoning spam transfers (5.5% of all), excluded from every payment metric. Left in, they would have made small payments look far bigger than they are.Æ
Æ
</run><run fontcolor="#1f2d3d" fontsize="11" bold="true">Lake to warehouse: </run><run fontcolor="#1f2d3d" fontsize="11">Redshift reconciles to the S3 lake exactly on row count and a business measure.</run></formatted-text></zone><zone floating="true" id="15" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard><dashboard name="7 Payout planner"><style /><size maxheight="800" maxwidth="1200" minheight="800" minwidth="1200" sizing-mode="fixed" /><zones><zone h="100000" id="2" w="100000" x="0" y="0" type-v2="layout-basic"><zone floating="true" id="11" x="1666" y="1250" w="96666" h="4250" type-v2="text"><formatted-text><run fontcolor="#1f2d3d" fontsize="20" bold="true">Payout planner</run></formatted-text></zone><zone floating="true" id="12" x="1666" y="5500" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#4a5568" fontsize="12">Question: what will network fees cost our payouts, and how much does timing save?</run></formatted-text></zone><zone floating="true" id="13" mode="slider" param="[Parameters].[p_recipients]" x="1666" y="10000" w="23333" h="7500" type-v2="paramctrl" /><zone floating="true" id="14" mode="slider" param="[Parameters].[p_payout]" x="1666" y="18125" w="23333" h="7500" type-v2="paramctrl" /><zone floating="true" id="15" name="KPI Saving" x="26666" y="11000" w="23333" h="6875" show-title="false" /><zone floating="true" id="16" x="26666" y="17750" w="23333" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">saved per year by sending at the day's cheapest hour</run></formatted-text></zone><zone floating="true" id="17" name="KPI Fee pct" x="50833" y="11000" w="23333" h="6875" show-title="false" /><zone floating="true" id="18" x="50833" y="17750" w="23333" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">fee as % of payout, sending any time</run></formatted-text></zone><zone floating="true" id="19" name="KPI Fee pct cheap" x="75000" y="11000" w="23333" h="6875" show-title="false" /><zone floating="true" id="20" x="75000" y="17750" w="23333" h="4500" type-v2="text"><formatted-text><run fontcolor="#666666" fontsize="10">fee as % of payout, cheapest hour</run></formatted-text></zone><zone floating="true" id="21" name="Monthly fee bill" x="1666" y="26875" w="46666" h="68125" /><zone floating="true" id="22" name="Cheapest hours heatmap" x="49166" y="26875" w="49166" h="68125" /><zone floating="true" id="23" x="1666" y="96250" w="96666" h="3250" type-v2="text"><formatted-text><run fontcolor="#8a94a6" fontsize="8">Source: AWS Public Blockchain Data (Ethereum), every USDC, USDT, DAI and PYUSD transfer, Jul 2023 to Jun 2025. Processed with PySpark on AWS Glue, modelled in dbt and Redshift. github.com/Vedika1102/stablecoin-payments-intelligence</run></formatted-text></zone></zone></zones></dashboard></dashboards><windows source-height="30"><window class="dashboard" maximized="true" name="1 Executive overview"><viewpoints /><active id="-1" /></window><window class="dashboard" maximized="true" name="2 What stablecoins are used for"><viewpoints /><active id="-1" /></window><window class="dashboard" maximized="true" name="3 Fees and small payments"><viewpoints /><active id="-1" /></window><window class="dashboard" maximized="true" name="4 Natural experiment Dencun"><viewpoints /><active id="-1" /></window><window class="dashboard" maximized="true" name="5 Wallet lifecycle"><viewpoints /><active id="-1" /></window><window class="dashboard" maximized="true" name="6 Data quality"><viewpoints /><active id="-1" /></window><window class="dashboard" maximized="true" name="7 Payout planner"><viewpoints /><active id="-1" /></wind