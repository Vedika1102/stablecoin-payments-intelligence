_c_pay_share]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM(IF [flow_category] = &quot;p2p_small_ticket&quot; THEN [transfers] END) / SUM(IF [flow_category] != &quot;dust_spam&quot; THEN [transfers] END)" /></column><column-instance column="[Calculation_c_pay_share]" derivation="User" name="[usr:Calculation_c_pay_share:qk]" pivot="key" type="quantitative" /><column-instance column="[activity_date]" derivation="Month-Trunc" name="[tmn:activity_date:qk]" pivot="key" type="quantitative" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Line" /><encodings /></pane></panes><rows>[federated.paymentmixdaily].[usr:Calculation_c_pay_share:qk]</rows><cols>[federated.paymentmixdaily].[tmn:activity_date:qk]</cols></table></worksheet><worksheet name="Flow mix by month"><layout-options><title><formatted-text><run bold="true" fontsize="13">Share of transfers by flow type, monthly</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Payment mix (daily)" name="federated.paymentmixdaily" /></datasources><datasource-dependencies datasource="federated.paymentmixdaily"><column datatype="date" name="[activity_date]" role="dimension" type="quantitative" /><column datatype="string" name="[flow_category]" role="dimension" type="nominal" /><column datatype="real" name="[transfers]" role="measure" type="quantitative" /><column caption="Flow label" datatype="string" name="[Calculation_c_flow_label]" role="dimension" type="nominal"><calculation class="tableau" formula="CASE [flow_category] WHEN &quot;p2p_small_ticket&quot; THEN &quot;P2P under $1K&quot; WHEN &quot;p2p_large_ticket&quot; THEN &quot;P2P $1K+&quot; WHEN &quot;contract_flow&quot; THEN &quot;Contract flows&quot; WHEN &quot;dust_spam&quot; THEN &quot;Dust / spam&quot; ELSE &quot;Mint / burn&quot; END" /></column><column caption="Share of transfers" datatype="real" name="[Calculation_c_share_tx]" role="measure" type="quantitative" default-format="p0%"><calculation class="tableau" formula="SUM([transfers]) / MIN({EXCLUDE [flow_category] : SUM([transfers])})" /></column><column-instance column="[Calculation_c_share_tx]" derivation="User" name="[usr:Calculation_c_share_tx:qk]" pivot="key" type="quantitative" /><column-instance column="[activity_date]" derivation="Month-Trunc" name="[tmn:activity_date:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_flow_label]" derivation="None" name="[none:Calculation_c_flow_label:nk]" pivot="key" type="nominal" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Area" /><encodings><color column="[federated.paymentmixdaily].[none:Calculation_c_flow_label:nk]" /></encodings></pane></panes><rows>[federated.paymentmixdaily].[usr:Calculation_c_share_tx:qk]</rows><cols>[federated.paymentmixdaily].[tmn:activity_date:qk]</cols></table></worksheet><worksheet name="Transfers vs value"><layout-options><title><formatted-text><run bold="true" fontsize="13">Most transfers are small payments, but almost all value is large flows</run></formatted-text></title></layout-options><table><view><datasources><datasource caption="Payment mix (daily)" name="federated.paymentmixdaily" /></datasources><datasource-dependencies datasource="federated.paymentmixdaily"><column datatype="string" name="[flow_category]" role="dimension" type="nominal" /><column datatype="real" name="[transfers]" role="measure" type="quantitative" /><column datatype="real" name="[volume_usd]" role="measure" type="quantitative" /><column caption="Flow label" datatype="string" name="[Calculation_c_flow_label]" role="dimension" type="nominal"><calculation class="tableau" formula="CASE [flow_category] WHEN &quot;p2p_small_ticket&quot; THEN &quot;P2P under $1K&quot; WHEN &quot;p2p_large_ticket&quot; THEN &quot;P2P $1K+&quot; WHEN &quot;contract_flow&quot; THEN &quot;Contract flows&quot; WHEN &quot;dust_spam&quot; THEN &quot;Dust / spam&quot; ELSE &quot;Mint / burn&quot; END" /></column><column caption="Share of all transfers" datatype="real" name="[Calculation_c_share_tx_all]" role="measure" type="quantitative" default-format="p0.0%"><calculation class="tableau" formula="SUM([transfers]) / MIN({FIXED : SUM([transfers])})" /></column><column caption="Share of all value" datatype="real" name="[Calculation_c_share_vol_all]" role="measure" type="quantitative" default-format="p0.00%"><calculation class="tableau" formula="SUM([volume_usd]) / MIN({FIXED : SUM([volume_usd])})" /></column><column-instance column="[Calculation_c_flow_label]" derivation="None" name="[none:Calculation_c_flow_label:nk]" pivot="key" type="nominal" /><column-instance column="[Calculation_c_share_tx_all]" derivation="User" name="[usr:Calculation_c_share_tx_all:qk]" pivot="key" type="quantitative" /><column-instance column="[Calculation_c_share_vol_all]" derivation="User" name="[usr:Calculation_c_share_vol_all:qk]" pivot="key" type="quantitative" /></datasource-dependencies><aggregation value="true" /></view><style /><panes><pane selection-relaxation-option="selection-relaxation-allow"><view><breakdown value="auto" /></view><mark class="Bar" /><encodings><color column="[federated.paymentmixdaily].[none:Calculation_c_flow_label:nk]" /></encodings></pane></panes><rows>[federated.paymentmixdaily].[none:Calculation_c_flow_label:nk]</rows><cols>([federated.paymentmixdaily].[usr:Calculation_c_share_tx_all:qk] / [federated.paymentmixdaily].[usr:Calculation_c_share_vol_all:qk])</cols></table></worksheet><worksheet name="Segments"><layout-options><title><formatted-text><run bold="true" fontsize="13">Payment-like wallets are the largest segment by count, services move the value</run></formatted-text></title></layout-option